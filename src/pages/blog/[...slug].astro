---
import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { config } from "../../consts";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => {
    return data.draft !== true;
  });
  return posts.map((post) => {
    return {
      params: { slug: post.id },
      props: { post },
    };
  });
}

const { post } = Astro.props;

if (!post) {
  return new Response(null, {
    status: 404,
    statusText: "Not found",
  });
}

let author = { data: { name: "邓律师" } };

if (post?.data?.author) {
  try {
    const authorEntry = await getEntry(post.data.author);
    if (authorEntry) author = authorEntry;
  } catch (error) {
    console.warn("Author not found:", post.data.author);
  }
}

const { Content } = await render(post);
---

<Layout
  title={`${post.data.title} — 邓律师`}
  description={post.data.description}
  image={post.data.image?.src}
  type="article"
  publishDate={post.data.publishDate}
  updateDate={post.data.updateDate}
  author={author.data}
>
  <article class="max-w-3xl mx-auto">
    <h1>{post.data.title}</h1>
    {
      post.data.image && (
        <img
          src={`${config.base}${post.data.image.src}`}
          alt={post.data.image.alt || post.data.title}
          class="w-full rounded-lg mb-6"
        />
      )
    }
    <p class="text-sm opacity-70 mb-4">
      {author.data.name} · <time datetime={post.data.publishDate.toISOString()}>
        {post.data.publishDate.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
      </time>
      {post.data.updateDate &&
        post.data.updateDate?.valueOf() !== post.data.publishDate.valueOf() && (
          <> · 更新于 {post.data.updateDate?.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}</>
        )
      }
    </p>
    {
      post.data.tag && post.data.tag.length > 0 && (
        <div class="flex flex-wrap gap-2 mb-6">
          {post.data.tag.map((t: string) => (
            <span class="badge badge-outline">{t}</span>
          ))}
        </div>
      )
    }
    <hr class="mb-8" />
    <Content />
    <hr class="mt-8 mb-8" />
    <div class="bg-base-200 rounded-lg p-6">
      <p class="text-sm font-semibold mb-2">{author.data.name}，执业律师</p>
      <p class="text-sm opacity-70">
        本文仅供交流参考，不构成法律意见。如需法律咨询，请通过联系方式与作者联系。
      </p>
    </div>
  </article>
</Layout>
