---
import { getCollection } from "astro:content";
import Layout from "../../components/Layout.astro";
import StructuredData from "../../components/StructuredData.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, author, tags, image } = post.data;
const { Content } = await post.render();
---

<Layout title={`${title} — 邓珂律师`} description={description} ogImage={image}>
  <StructuredData
    type="Article"
    title={title}
    description={description}
    url={new URL(`/blog/${post.slug}/`, Astro.site).toString()}
    pubDate={pubDate.toISOString()}
    updatedDate={updatedDate?.toISOString()}
    authorName={author}
    image={image}
  />

  <article class="max-w-3xl mx-auto px-4 py-16">
    <header class="mb-10">
      <h1 class="text-3xl font-bold text-gray-900 mb-4">{title}</h1>
      <p class="text-lg text-gray-500 mb-4">{description}</p>
      <div class="flex items-center gap-4 text-sm text-gray-400">
        <time datetime={pubDate.toISOString().split("T")[0]}>
          {pubDate.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
        </time>
        <span>作者：{author}</span>
      </div>
      {tags && tags.length > 0 && (
        <div class="flex gap-2 mt-4">
          {tags.map((tag: string) => (
            <span class="bg-gray-100 text-gray-600 text-xs px-2 py-1 rounded">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="mt-16 pt-8 border-t border-gray-100">
      <div class="bg-primary-50 rounded-lg p-6">
        <p class="text-sm text-gray-700 mb-2">
          <strong>作者：{author}</strong>，执业律师
        </p>
        <p class="text-sm text-gray-500">
          本文仅供交流参考，不构成法律意见。如需法律咨询，请通过首页联系方式与作者联系。
        </p>
      </div>
    </footer>
  </article>
</Layout>
