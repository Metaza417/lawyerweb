---
import Layout from "../../components/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout
  title="文章列表 — 邓珂律师"
  description="民商事争议解决、合同纠纷、公司法实务等专业法律文章。"
>
  <div class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold text-gray-900 mb-8">文章列表</h1>
    <p class="text-gray-500 mb-8">共 {posts.length} 篇文章</p>

    {posts.length === 0 ? (
      <p class="text-gray-400 text-center py-12">暂无文章。</p>
    ) : (
      posts.map((post) => <ArticleCard post={post} />)
    )}
  </div>
</Layout>
