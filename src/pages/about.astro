---
import Layout from "../layouts/Layout.astro";
import { config } from "../consts";

const title = "关于我";
const description = "邓律师的执业介绍、专业领域与联系方式。";
---

<Layout title={`${title} — 邓律师`} description={description}>
  <div class="max-w-3xl mx-auto">
    <h1 class="animate-fade-up mb-8">{title}</h1>

    <section class="animate-fade-up prose max-w-none">
      <h2>执业信息</h2>
      <ul>
        <li><strong>姓名：</strong>邓律师</li>
        <li><strong>简介：</strong>华中科技大学硕士，专利代理人，曾从事通信、计算机研发及网络运维工作十余年，具有互联网行业及知识产权相关的法律实务工作经验。</li>
      </ul>

      <h2>专业领域</h2>
      <p>
        长期专注于知识产权诉讼与民商事争议解决，在专利侵权、计算机软件著作权、商业秘密保护以及复杂合同纠纷等领域具有丰富的实务经验。同时为政府部门提供法律顾问服务。
