---
import Layout from "../layouts/Layout.astro";
import { config } from "../consts";

const title = "404";
const description = "页面未找到";
const content = "抱歉，您访问的页面不存在或已被移动。";
---

<Layout title={`${title}: ${description} — 邓律师`} description={description}>
  <main class="flex min-h-[60vh] flex-col items-center justify-center py-20 text-center">
    <h1 class="text-error mb-4 text-6xl sm:text-9xl">{title}</h1>
    <h2 class="mt-0 mb-4 text-2xl font-semibold sm:text-4xl">{description}</h2>
    <p class="text-base-content mb-8">{content}</p>
    <a href={`${config.base}/`} class="btn btn-lg sm:btn-xl px-8 py-3 text-lg">
      返回首页
    </a>
  </main>
</Layout>
