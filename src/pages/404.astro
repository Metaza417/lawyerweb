---
import Layout from "../components/Layout.astro";
---

<Layout title="404 — 页面未找到" description="页面不存在">
  <div class="max-w-2xl mx-auto px-4 py-32 text-center">
    <h1 class="text-6xl font-bold text-gray-200 mb-4">404</h1>
    <p class="text-xl text-gray-600 mb-8">页面不存在</p>
    <a href="/" class="text-primary-600 hover:text-primary-700 underline">返回首页</a>
  </div>
</Layout>
