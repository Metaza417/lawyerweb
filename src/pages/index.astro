---
import Layout from "../components/Layout.astro";
import StructuredData from "../components/StructuredData.astro";
import ArticleCard from "../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 5);
---

<Layout
  title="邓珂律师 — 争议解决与公司法实务"
  description="专注于民商事诉讼、合同纠纷、公司法务，提供专业法律分析与案件代理服务。"
>
  <StructuredData
    type="WebSite"
    title="邓珂律师"
    description="专注于民商事诉讼、合同纠纷、公司法务，提供专业法律分析与案件代理服务。"
    url={Astro.site?.toString() ?? ""}
  />

  <!-- Hero -->
  <section class="bg-gradient-to-b from-primary-50 to-white py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl font-bold text-gray-900 mb-4">邓珂 律师</h1>
      <p class="text-lg text-gray-600 mb-6 max-w-2xl mx-auto leading-relaxed">
        专注于民商事争议解决、合同纠纷与公司法实务，致力于为客户提供专业、高效的法律服务。
      </p>
      <div class="flex justify-center gap-4">
        <a href="/blog/" class="bg-primary-600 text-white px-6 py-3 rounded-lg hover:bg-primary-700 transition-colors text-sm">
          阅读文章
        </a>
        <a href="/about/" class="border border-gray-300 text-gray-700 px-6 py-3 rounded-lg hover:border-primary-600 hover:text-primary-600 transition-colors text-sm">
          关于我
        </a>
      </div>
    </div>
  </section>

  <!-- Recent Articles -->
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-gray-900">最新文章</h2>
      <a href="/blog/" class="text-primary-600 hover:text-primary-700 text-sm">
        查看全部 &rarr;
      </a>
    </div>

    {posts.length === 0 ? (
      <p class="text-gray-400 text-center py-12">暂无文章。</p>
    ) : (
      posts.map((post) => <ArticleCard post={post} />)
    )}
  </section>
</Layout>
