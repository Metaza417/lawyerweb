---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<article class="border-b border-gray-100 py-6 last:border-0">
  <a href={`/blog/${post.slug}/`} class="group block">
    <h2 class="text-xl font-semibold text-gray-900 group-hover:text-primary-600 transition-colors mb-2">
      {title}
    </h2>
    <p class="text-gray-500 text-sm leading-relaxed mb-3">{description}</p>
    <div class="flex items-center gap-4 text-xs text-gray-400">
      <time datetime={pubDate.toISOString().split("T")[0]}>
        {pubDate.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
      </time>
      {tags && tags.length > 0 && (
        <span class="flex gap-2">
          {tags.map((tag) => (
            <span class="bg-gray-100 px-2 py-0.5 rounded">{tag}</span>
          ))}
        </span>
      )}
    </div>
  </a>
</article>
