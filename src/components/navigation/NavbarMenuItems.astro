---
const mainMenu = [
  { label: "首页", href: "/" },
  { label: "文章", href: "/blog/" },
  { label: "关于", href: "/about/" },
];

const { menu = mainMenu } = Astro.props;
---

{menu.map((item) => (
  <li class="w-max">
    <a href={item.href} aria-label={item.label}>
      {item.label}
    </a>
  </li>
))}
